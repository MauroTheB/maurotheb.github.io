---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'it' | 'fr';
  image?: string;
}

const {
  title = "Mauro Julien Brochier | Technical Game Designer",
  description = "Technical Game Designer & Systems Engineer. Gameplay systems, AI architecture, DDA research, and high-performance C#/C++ implementation.",
  lang = "en",
  image = "/images/pomegranate_preview.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://maurotheb.github.io");
const socialImageURL = new URL(image, Astro.site || "https://maurotheb.github.io");
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Meta Tag Principali -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#020617" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="Mauro Julien Brochier Portfolio" />

    <!-- Twitter / X / Discord Embeds -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    {lang === 'en' && (
      <script is:inline>
        (function () {
          try {
            var path = window.location.pathname;
            if (path !== '/' && path !== '/index.html') return;
            if (sessionStorage.getItem('portfolio:lang-transition')) return;
            if (localStorage.getItem('portfolio:preferred-lang')) return;

            var langs = navigator.languages && navigator.languages.length
              ? Array.prototype.slice.call(navigator.languages)
              : [navigator.language || ''];

            var target = '';
            for (var i = 0; i < langs.length; i++) {
              var code = String(langs[i] || '').toLowerCase().split('-')[0];
              if (code === 'it') { target = '/it/'; break; }
              if (code === 'fr') { target = '/fr/'; break; }
              if (code === 'en') { break; }
            }

            if (target) {
              document.documentElement.style.visibility = 'hidden';
              window.location.replace(target + window.location.search + window.location.hash);
            }
          } catch (e) {}
        })();
      </script>
    )}

    <script is:inline>
      try {
        var raw = sessionStorage.getItem('portfolio:lang-transition');
        if (raw) {
          var data = JSON.parse(raw);
          if (data && Date.now() - data.ts < 5000) {
            document.documentElement.style.visibility = 'hidden';
            setTimeout(function () {
              document.documentElement.style.visibility = '';
            }, 600);
          }
        }
      } catch (e) {}
    </script>

  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased selection:bg-violet-500/25 selection:text-violet-300">
    <div class="relative min-h-screen flex flex-col justify-between">
      <!-- Contenuto dinamico delle pagine iniettato qui -->
      <slot />
    </div>
  </body>

  <!-- Tracker Visite Uniche Privacy-First -->
  <script>
    (function () {
      const WORKER_URL = 'https://nameless-hall-16b7.mauro-brochier97.workers.dev/'; 
      
      if (!WORKER_URL.includes('workers.dev')) return;

      const path = window.location.pathname;
      const locale = document.documentElement.lang || 'en';

      // Chiamata fire-and-forget con keepalive (non blocca né rallenta il caricamento del sito)
      fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path, locale }),
        keepalive: true
      }).catch(() => {
        // Silenzia eventuali blocchi di adblocker per massima resilienza
      });
    })();
  </script>
</html>