---
// Effetto Murder Mystery: Apparizione Minacciosa da Fuori Schermo, Pozza di Sangue Realistica e Target HUD
---

<!-- 1. Canvas 2D per la pozza di sangue iper-definita (posizionato a z-0 dietro alla scheda) -->
<canvas
    id="murder-blood-canvas"
    class="fixed inset-0 pointer-events-none z-0 opacity-0 transition-opacity duration-700 select-none"
></canvas>

<!-- 1.5 Canvas 2D IN PRIMO PIANO (z-40) per la fontanella di sangue visibile all'impatto -->
<canvas
    id="murder-spurt-canvas"
    class="fixed inset-0 pointer-events-none z-40 select-none"></canvas>

<!-- 2. Palcoscenico delle armi nelle quinte laterali -->
<div
    id="murder-weapons-stage"
    class="absolute inset-x-0 top-0 pointer-events-none z-30 hidden xl:block select-none"
>
    <!-- Le armi strisciano qui da fuori schermo con animazione inquietante -->
</div>

<script>
    interface WeaponDef {
        id: string;
        name: string;
        cleanSrc: string;
        bloodySrc: string;
        isLeft: boolean;
        scale: number;
        angle: number;
    }

    interface SplatterDrop {
        x: number;
        y: number;
        r: number;
        alpha: number;
    }

    interface WeaponDrip {
        startX: number;
        startY: number;
        length: number;
        width: number;
    }

    function setupMurderMysteryAssassination() {
        const stage = document.getElementById(
            "murder-weapons-stage",
        ) as HTMLElement;
        const canvas = document.getElementById(
            "murder-blood-canvas",
        ) as HTMLCanvasElement;
        const spurtCanvas = document.getElementById(
            "murder-spurt-canvas",
        ) as HTMLCanvasElement;
        if (!stage || !canvas || !spurtCanvas) return;

        const ctx = canvas.getContext("2d");
        const spurtCtx = spurtCanvas.getContext("2d");
        if (!ctx || !spurtCtx) return;

        let isActive = false;
        let bloodRadius = 0;
        let targetBloodRadius = 0;
        let weaponsThrown = 0;
        let isLoopRunning = false;

        // Lobi organici per un perimetro asimmetrico e vischioso
        const bloodLobes = [
            1.28, 0.76, 1.38, 0.82, 1.48, 0.94, 1.22, 0.72, 1.44, 0.86, 1.52,
            0.92, 1.34, 0.7, 1.42, 0.88, 1.46, 0.9, 1.26, 0.78, 1.36, 0.84,
        ];

        const WEAPON_DATA: WeaponDef[] = [
            {
                id: "knife",
                name: "Coltello",
                cleanSrc: "/images/knife.svg",
                bloodySrc: "/images/knife sangue.svg",
                isLeft: true,
                scale: 1.25,
                angle: -25,
            },
            {
                id: "gun",
                name: "Pistola Silenziata",
                cleanSrc: "/images/gun.svg",
                bloodySrc: "/images/gun.svg",
                isLeft: true,
                scale: 1.3,
                angle: 15,
            },
            {
                id: "bottiglia",
                name: "Bottiglia di Veleno",
                cleanSrc: "/images/bottiglia.svg",
                bloodySrc: "/images/bottiglia.svg",
                isLeft: true,
                scale: 1.15,
                angle: -10,
            },
            {
                id: "mannaia",
                name: "Mannaia Pesante",
                cleanSrc: "/images/mannaia.svg",
                bloodySrc: "/images/mannaia sangue.svg",
                isLeft: false,
                scale: 1.3,
                angle: 30,
            },
            {
                id: "cash",
                name: "Mazzetta di Denaro",
                cleanSrc: "/images/cash.svg",
                bloodySrc: "/images/cash.svg",
                isLeft: false,
                scale: 1.15,
                angle: -15,
            },
        ];

        const TOTAL_WEAPONS = WEAPON_DATA.length;

        interface FlyingBlood {
            x: number;
            y: number;
            vx: number;
            vy: number;
            r: number;
            alpha: number;
        }
        let flyingParticles: FlyingBlood[] = [];
        let permanentSplatters: SplatterDrop[] = [];
        let weaponDrips: WeaponDrip[] = [];

        function resize() {
            if (!canvas || !ctx || !spurtCanvas || !spurtCtx) return;
            const dpr = window.devicePixelRatio || 1;
            const w = window.innerWidth;
            const h = window.innerHeight;

            canvas.width = Math.round(w * dpr);
            canvas.height = Math.round(h * dpr);
            canvas.style.width = `${w}px`;
            canvas.style.height = `${h}px`;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            spurtCanvas.width = Math.round(w * dpr);
            spurtCanvas.height = Math.round(h * dpr);
            spurtCanvas.style.width = `${w}px`;
            spurtCanvas.style.height = `${h}px`;
            spurtCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener("resize", resize);

        // Genera le armi distribuendole su tutta la pagina con entrata da fuori schermo
        function spawnWeapons() {
            stage.innerHTML = "";
            weaponsThrown = 0;
            bloodRadius = 0;
            targetBloodRadius = 0;
            flyingParticles = [];
            permanentSplatters = [];
            weaponDrips = [];

            const screenW = window.innerWidth;

            // 1. Limite superiore assoluto (Sotto la riga della Hero, MAI sopra)
            const heroHeader = document.getElementById("hero-header");
            const safeMinY = heroHeader
                ? heroHeader.offsetTop + heroHeader.offsetHeight + 40
                : 750;

            // 2. Limite inferiore assoluto (Fondo pagina)
            const maxDocY = Math.max(
                document.documentElement.scrollHeight - 180,
                safeMinY + 1200,
            );
            const totalSpan = maxDocY - safeMinY;

            // 3. Corsie laterali certe basate sulla scheda espansa finale (1280px centrata)
            // Elimina all'origine il bug delle armi posizionate al centro durante il FLIP
            const gutterWidth = Math.max(70, (screenW - 1280) / 2);

            injectTargetHUD();

            const leftWeapons = WEAPON_DATA.filter((w) => w.isLeft);
            const rightWeapons = WEAPON_DATA.filter((w) => !w.isLeft);

            WEAPON_DATA.forEach((w, idx) => {
                const weaponEl = document.createElement("div");
                weaponEl.className =
                    "murder-weapon-item absolute pointer-events-auto cursor-pointer will-change-transform";

                // Posizione finale nelle quinte laterali (Confinata rigorosamente tra il bordo e la scheda)
                const finalX = w.isLeft
                    ? Math.floor(
                          Math.random() * Math.max(30, gutterWidth - 120) + 30,
                      )
                    : Math.floor(
                          screenW -
                              gutterWidth +
                              25 +
                              Math.random() * Math.max(30, gutterWidth - 120),
                      );

                // Distribuzione verticale scaglionata lungo l'intera pagina
                const sideIndex = w.isLeft
                    ? leftWeapons.indexOf(w)
                    : rightWeapons.indexOf(w);
                const sideTotal = w.isLeft
                    ? leftWeapons.length
                    : rightWeapons.length;
                const slotH = totalSpan / (sideTotal + 1);
                const yPos =
                    safeMinY +
                    (sideIndex + 1) * slotH +
                    (Math.random() * 40 - 20);

                // PARTENZA FISICA OLTRE IL MONITOR (Completamente invisibili fuori schermo)
                const offscreenX = w.isLeft ? -160 : screenW + 160;

                weaponEl.style.left = `${offscreenX}px`;
                weaponEl.style.top = `${yPos}px`;
                weaponEl.style.opacity = "0";
                weaponEl.style.transform = `translate(-50%, -50%) rotate(${w.angle}deg) scale(${w.scale})`;

                weaponEl.innerHTML = `
          <img 
            src="${encodeURI(w.cleanSrc)}" 
            alt="${w.name}" 
            class="weapon-img w-16 h-16 sm:w-20 sm:h-20 object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.9)] hover:scale-120 hover:drop-shadow-[0_0_22px_rgba(244,63,94,0.75)] transition-transform duration-200 active:scale-95" 
            draggable="false" 
          />
        `;

                // Entrata lenta, minacciosa e a cascata (Scivolamento fluido da oltre la cornice)
                const staggerDelay = idx * 220 + 200; // Ritardo progressivo per ciascuna arma
                setTimeout(() => {
                    weaponEl.style.transition =
                        "left 1.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease-out";
                    weaponEl.style.left = `${finalX}px`;
                    weaponEl.style.opacity = "1";
                }, staggerDelay);

                weaponEl.addEventListener(
                    "click",
                    () => {
                        if (weaponEl.classList.contains("launched")) return;
                        weaponEl.classList.add("launched");
                        weaponEl.style.transition = "none"; // Sblocca per il lancio ad alta velocità
                        launchWeapon(weaponEl, w, finalX, yPos);
                    },
                    { once: true },
                );

                stage.appendChild(weaponEl);
            });
        }

        function injectTargetHUD() {
            const existing = document.getElementById("target-hud-badge");
            if (existing) existing.remove();

            const detailCard = document.getElementById("detail-card-container");
            if (!detailCard) return;

            const badge = document.createElement("div");
            badge.id = "target-hud-badge";
            badge.className =
                "absolute top-4 right-4 z-20 flex items-center gap-2 px-3 py-1 rounded-full bg-slate-950/90 border border-emerald-500/40 text-[11px] font-mono text-emerald-400 tracking-wider shadow-lg backdrop-blur-md transition-all duration-500";
            badge.innerHTML = `
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="target-hud-text">TARGET: SECURE // 100% INTEGRITY</span>
      `;
            detailCard.appendChild(badge);
        }

        function updateTargetHUD(hits: number) {
            const badge = document.getElementById("target-hud-badge");
            const text = document.getElementById("target-hud-text");
            if (!badge || !text) return;

            const health = Math.max(0, 100 - hits * 20);

            if (health > 50) {
                badge.className =
                    "absolute top-4 right-4 z-20 flex items-center gap-2 px-3 py-1 rounded-full bg-slate-950/90 border border-amber-500/40 text-[11px] font-mono text-amber-400 tracking-wider shadow-lg backdrop-blur-md transition-all duration-500";
                badge.querySelector("span")?.classList.remove("bg-emerald-400");
                badge.querySelector("span")?.classList.add("bg-amber-400");
                text.textContent = `TARGET: COMPROMISED // ${health}% INTEGRITY`;
            } else if (health > 0) {
                badge.className =
                    "absolute top-4 right-4 z-20 flex items-center gap-2 px-3 py-1 rounded-full bg-slate-950/90 border border-rose-500/60 text-[11px] font-mono text-rose-400 tracking-wider shadow-[0_0_15px_rgba(244,63,94,0.4)] backdrop-blur-md transition-all duration-500";
                badge.querySelector("span")?.classList.remove("bg-amber-400");
                badge.querySelector("span")?.classList.add("bg-rose-400");
                text.textContent = `TARGET: CRITICAL // ${health}% INTEGRITY`;
            } else {
                badge.className =
                    "absolute top-4 right-4 z-20 flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-950/90 border-2 border-rose-500 text-xs font-mono text-rose-300 font-bold tracking-widest shadow-[0_0_25px_rgba(244,63,94,0.6)] backdrop-blur-md animate-pulse";
                text.textContent = `TARGET ELIMINATED // PERFECT MURDER [☠]`;
            }
        }

        function launchWeapon(
            el: HTMLElement,
            w: WeaponDef,
            startX: number,
            startY: number,
        ) {
            const detailCard = document.getElementById("detail-card-container");
            if (!detailCard) return;

            const cardRect = detailCard.getBoundingClientRect();
            const targetX = w.isLeft ? cardRect.left + 20 : cardRect.right - 20;
            const targetY = startY + (Math.random() * 80 - 40);
            const flySpin = w.angle + (w.isLeft ? 180 : -180);

            el.style.transition =
                "left 0.28s cubic-bezier(0.1, 0.9, 0.15, 1), top 0.28s cubic-bezier(0.1, 0.9, 0.15, 1), transform 0.28s cubic-bezier(0.1, 0.9, 0.15, 1)";
            el.style.left = `${targetX}px`;
            el.style.top = `${targetY}px`;
            el.style.transform = `translate(-50%, -50%) rotate(${flySpin}deg) scale(${w.scale})`;

            setTimeout(() => {
                weaponsThrown++;

                const img = el.querySelector("img");
                if (img && w.bloodySrc) {
                    img.src = encodeURI(w.bloodySrc);
                }

                el.classList.add("stuck-quiver");
                el.style.zIndex = "35";

                detailCard.classList.remove(
                    "damage-recoil-left",
                    "damage-recoil-right",
                );
                void detailCard.offsetWidth;
                detailCard.classList.add(
                    w.isLeft ? "damage-recoil-right" : "damage-recoil-left",
                );

                spawnBloodSpurt(targetX, targetY, w.isLeft);

                // Rivolo di sangue che cola lungo il bordo
                weaponDrips.push({
                    startX: targetX,
                    startY: targetY,
                    length: Math.random() * 110 + 60,
                    width: Math.random() * 2.5 + 2,
                });

                targetBloodRadius += 65;
                updateTargetHUD(weaponsThrown);
            }, 270);
        }

        // Genera la fontanella di sangue balistica ad alta pressione (35 zampilli allungati)
        function spawnBloodSpurt(x: number, y: number, fromLeft: boolean) {
            const count = 35; // Più del doppio delle gocce

            for (let i = 0; i < count; i++) {
                // Angolo a fontanella: schizza verso l'alto e verso l'esterno con arco parabolico
                const baseAngle = fromLeft ? -Math.PI * 0.42 : -Math.PI * 0.58;
                const spraySpread = (Math.random() - 0.5) * 0.75;
                const angle = baseAngle + spraySpread;

                // Velocità balistica esplosiva (da 7 a 15 pixel/frame)
                const speed = Math.random() * 8 + 7;

                flyingParticles.push({
                    x,
                    y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - Math.random() * 3, // Spinta violenta verso l'alto
                    r: Math.random() * 2.8 + 1.2,
                    alpha: 1,
                });
            }

            // Macchie d'impatto permanenti sulla parete
            for (let s = 0; s < 6; s++) {
                const splatterDist = Math.random() * 85 + 25;
                const angle =
                    (fromLeft ? -Math.PI * 0.5 : -Math.PI * 0.5) +
                    (Math.random() - 0.5) * 1.5;
                permanentSplatters.push({
                    x: x + Math.cos(angle) * splatterDist,
                    y: y + Math.sin(angle) * splatterDist,
                    r: Math.random() * 3.8 + 1.8,
                    alpha: 0.95,
                });
            }
        }

        // Render 2D della pozza di sangue con stratificazione PBR e riflessi bagnati
        function renderBlood() {
            if (!isActive || !ctx || !canvas) {
                isLoopRunning = false;
                return;
            }

            ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
            const scrollY = window.scrollY;

            const detailCard = document.getElementById("detail-card-container");
            if (detailCard) {
                const cardRect = detailCard.getBoundingClientRect();
                const centerX = cardRect.left + cardRect.width / 2;
                const centerY = cardRect.top + cardRect.height / 2;

                bloodRadius += (targetBloodRadius - bloodRadius) * 0.04;

                if (bloodRadius > 2) {
                    ctx.save();

                    // 1. OMBRA DI CONTATTO SUL MURO
                    ctx.shadowColor = "rgba(0, 0, 0, 0.75)";
                    ctx.shadowBlur = 18;
                    ctx.shadowOffsetY = 8;

                    // Helper per calcolare i punti di una spline organica con gravità
                    const computePuddlePoints = (scaleMult: number) => {
                        const count = bloodLobes.length;
                        const pts: { x: number; y: number }[] = [];
                        for (let j = 0; j < count; j++) {
                            const a = (j / count) * Math.PI * 2;
                            const lobe = bloodLobes[j];
                            const isDown = Math.sin(a) > 0;
                            const grav = isDown ? 1 + Math.sin(a) * 0.42 : 0.85;

                            const rX =
                                (cardRect.width * 0.5 +
                                    bloodRadius * lobe * 0.9 * scaleMult) *
                                grav;
                            const rY =
                                (cardRect.height * 0.5 +
                                    bloodRadius * lobe * 0.78 * scaleMult) *
                                grav;

                            pts.push({
                                x: centerX + Math.cos(a) * rX,
                                y: centerY + Math.sin(a) * rY,
                            });
                        }
                        return pts;
                    };

                    const drawSplineFromPoints = (
                        pts: { x: number; y: number }[],
                    ) => {
                        if (!ctx) return;
                        const count = pts.length;
                        const startMidX = (pts[count - 1].x + pts[0].x) / 2;
                        const startMidY = (pts[count - 1].y + pts[0].y) / 2;
                        ctx.beginPath();
                        ctx.moveTo(startMidX, startMidY);
                        for (let j = 0; j < count; j++) {
                            const curr = pts[j];
                            const next = pts[(j + 1) % count];
                            const midX = (curr.x + next.x) / 2;
                            const midY = (curr.y + next.y) / 2;
                            ctx.quadraticCurveTo(curr.x, curr.y, midX, midY);
                        }
                        ctx.closePath();
                    };

                    // 2. STRATO ESTERNO DELLA POZZA (Sangue cremisi denso con menisco coagulato)
                    const outerPts = computePuddlePoints(1.0);
                    drawSplineFromPoints(outerPts);
                    ctx.fillStyle = "rgba(110, 8, 32, 0.95)";
                    ctx.fill();

                    ctx.strokeStyle = "rgba(30, 2, 8, 0.98)";
                    ctx.lineWidth = 3.5;
                    ctx.stroke();

                    // 3. NUCLEO CENTRALE DENSO E COAGULATO (Strato interno scuro ossidato)
                    ctx.shadowColor = "transparent";
                    const innerPts = computePuddlePoints(0.65);
                    drawSplineFromPoints(innerPts);
                    ctx.fillStyle = "rgba(38, 2, 10, 0.88)";
                    ctx.fill();

                    // 4. I 2 RIFLESSI A MEZZALUNA PIENA AFFUSOLATA (Zero tubi: spesso al centro, a punta alle estremità)
                    ctx.save();

                    // Calcola le coordinate concentriche al bordo
                    const getPuddleCoords = (
                        angleRad: number,
                        radiusScale: number,
                    ) => {
                        const count = bloodLobes.length;
                        const normA =
                            ((angleRad % (Math.PI * 2)) + Math.PI * 2) %
                            (Math.PI * 2);
                        const floatIdx = (normA / (Math.PI * 2)) * count;
                        const idx0 = Math.floor(floatIdx) % count;
                        const idx1 = (idx0 + 1) % count;
                        const fract = floatIdx - Math.floor(floatIdx);
                        const lobe =
                            bloodLobes[idx0] * (1 - fract) +
                            bloodLobes[idx1] * fract;

                        const isDown = Math.sin(angleRad) > 0;
                        const grav = isDown
                            ? 1 + Math.sin(angleRad) * 0.42
                            : 0.85;

                        const rX =
                            (cardRect.width * 0.5 +
                                bloodRadius * lobe * 0.9 * radiusScale) *
                            grav;
                        const rY =
                            (cardRect.height * 0.5 +
                                bloodRadius * lobe * 0.78 * radiusScale) *
                            grav;

                        return {
                            x: centerX + Math.cos(angleRad) * rX,
                            y: centerY + Math.sin(angleRad) * rY,
                        };
                    };

                    // Disegna un poligono pieno a forma di mezzaluna/spicchio (Crescent Polygon)
                    const drawCrescentHighlight = (
                        startA: number,
                        endA: number,
                        dotA: number,
                        maxThickPx: number,
                    ) => {
                        const stepsCount = 9;
                        const outerArc: { x: number; y: number }[] = [];
                        const innerArc: { x: number; y: number }[] = [];

                        const cardAvgR =
                            (cardRect.width + cardRect.height) * 0.25;

                        for (let s = 0; s <= stepsCount; s++) {
                            const u = s / stepsCount; // Da 0 (punta iniziale) a 1 (punta finale)
                            const a = startA + u * (endA - startA);

                            // Profilo di spessore sinusoidale: zero alle punte, massimo al centro esatto (0.5)
                            const thickness =
                                Math.sin(u * Math.PI) * maxThickPx;
                            const halfRadialRatio =
                                (thickness / (cardAvgR || 1)) * 0.5;

                            // Bordo superiore (esterno) e bordo inferiore (interno) dello spicchio
                            outerArc.push(
                                getPuddleCoords(a, 0.84 + halfRadialRatio),
                            );
                            innerArc.push(
                                getPuddleCoords(a, 0.84 - halfRadialRatio),
                            );
                        }

                        // Traccia il perimetro chiuso della mezzaluna
                        ctx.beginPath();
                        ctx.moveTo(outerArc[0].x, outerArc[0].y);

                        // Arco superiore
                        for (let i = 0; i < stepsCount; i++) {
                            const midX =
                                (outerArc[i].x + outerArc[i + 1].x) / 2;
                            const midY =
                                (outerArc[i].y + outerArc[i + 1].y) / 2;
                            ctx.quadraticCurveTo(
                                outerArc[i].x,
                                outerArc[i].y,
                                midX,
                                midY,
                            );
                        }
                        ctx.lineTo(
                            outerArc[stepsCount].x,
                            outerArc[stepsCount].y,
                        );

                        // Arco inferiore a ritroso (ritorna alla punta iniziale richiudendo lo spicchio)
                        for (let i = stepsCount; i > 0; i--) {
                            const midX =
                                (innerArc[i].x + innerArc[i - 1].x) / 2;
                            const midY =
                                (innerArc[i].y + innerArc[i - 1].y) / 2;
                            ctx.quadraticCurveTo(
                                innerArc[i].x,
                                innerArc[i].y,
                                midX,
                                midY,
                            );
                        }
                        ctx.closePath();

                        // Riempimento solido satinato cartoon (Zero spessore a tubo, campitura piena a mezzaluna!)
                        ctx.fillStyle = "rgba(255, 235, 240, 0.82)";
                        ctx.fill();

                        // B. Il micro-pallino bagnato sulla stessa traiettoria
                        const dotPt = getPuddleCoords(dotA, 0.84);
                        ctx.beginPath();
                        ctx.arc(
                            dotPt.x,
                            dotPt.y,
                            Math.max(1.8, maxThickPx * 0.28),
                            0,
                            Math.PI * 2,
                        );
                        ctx.fillStyle = "rgba(255, 235, 240, 0.82)";
                        ctx.fill();
                    };

                    const maxGlintThick = Math.max(6, bloodRadius * 0.065);

                    // RIFLESSO 1 (Mezzaluna Primaria): Ore 10:30 (larga al centro, a punta sui vertici)
                    drawCrescentHighlight(3.5, 3.88, 3.99, maxGlintThick);

                    // RIFLESSO 2 (Mezzaluna Secondaria): Ore 11:30
                    drawCrescentHighlight(
                        4.25,
                        4.46,
                        4.56,
                        maxGlintThick * 0.8,
                    );

                    ctx.restore();

                    // 5. RIVOLI CHE COLANO DALLE LAME
                    for (let drip of weaponDrips) {
                        const dY = drip.startY - scrollY;
                        ctx.beginPath();
                        ctx.moveTo(drip.startX, dY);
                        ctx.quadraticCurveTo(
                            drip.startX + (Math.random() - 0.5) * 6,
                            dY + drip.length * 0.5,
                            drip.startX + (Math.random() - 0.5) * 8,
                            dY + drip.length,
                        );
                        ctx.strokeStyle = "rgba(125, 10, 36, 0.92)";
                        ctx.lineWidth = drip.width;
                        ctx.lineCap = "round";
                        ctx.stroke();

                        ctx.beginPath();
                        ctx.arc(
                            drip.startX,
                            dY + drip.length,
                            drip.width * 1.2,
                            0,
                            Math.PI * 2,
                        );
                        ctx.fillStyle = "rgba(95, 5, 25, 0.96)";
                        ctx.fill();
                    }

                    ctx.restore();
                }

                // 6. SCHIZZI BALISTICI PERMANENTI
                for (let sp of permanentSplatters) {
                    const sy = sp.y - scrollY;
                    ctx.beginPath();
                    ctx.arc(sp.x, sy, sp.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(135, 10, 40, ${sp.alpha})`;
                    ctx.fill();
                    ctx.strokeStyle = "rgba(35, 2, 8, 0.85)";
                    ctx.lineWidth = 1;
                    ctx.stroke();
                }

                // 7. FONTANELLA DI SANGUE BALISTICA IN PRIMO PIANO (Disegnata su z-40 sopra la scheda!)
                if (spurtCtx) {
                    spurtCtx.clearRect(
                        0,
                        0,
                        window.innerWidth,
                        window.innerHeight,
                    );

                    for (let i = flyingParticles.length - 1; i >= 0; i--) {
                        const p = flyingParticles[i];
                        p.x += p.vx;
                        p.y += p.vy;
                        p.vy += 0.32; // Gravità che fa ricadere lo zampillo verso il basso
                        p.vx *= 0.95;
                        p.alpha *= 0.965;

                        const sy = p.y - scrollY;

                        // Disegna una striscia allungata lungo il vettore di velocità (goccia balistica reale)
                        spurtCtx.beginPath();
                        spurtCtx.moveTo(p.x, sy);
                        spurtCtx.lineTo(p.x - p.vx * 2.2, sy - p.vy * 2.2);
                        spurtCtx.strokeStyle = `rgba(225, 29, 72, ${p.alpha * 0.95})`; // Rosso vivo arterioso in primo piano
                        spurtCtx.lineWidth = Math.max(1.2, p.r * 1.4);
                        spurtCtx.lineCap = "round";
                        spurtCtx.stroke();

                        // Goccia terminale
                        spurtCtx.beginPath();
                        spurtCtx.arc(p.x, sy, p.r * 0.8, 0, Math.PI * 2);
                        spurtCtx.fillStyle = `rgba(185, 15, 55, ${p.alpha})`;
                        spurtCtx.fill();

                        if (p.alpha <= 0.02 || sy > window.innerHeight + 100) {
                            flyingParticles.splice(i, 1);
                        }
                    }
                }
            } // <-- Questa è la graffa che mancava (chiude if detailCard)

            requestAnimationFrame(renderBlood);
        } // <-- Chiude function renderBlood

        function wakeUpBloodLoop() {
            if (!isLoopRunning) {
                isLoopRunning = true;
                requestAnimationFrame(renderBlood);
            }
        }

        window.addEventListener("murder:mystery:start", () => {
            isActive = true;
            resize();
            spawnWeapons();
            canvas.style.opacity = "1";
            wakeUpBloodLoop();
        });

        window.addEventListener("murder:mystery:clear", () => {
            isActive = false;
            canvas.style.opacity = "0";
            stage.innerHTML = "";
            const badge = document.getElementById("target-hud-badge");
            if (badge) badge.remove();
            const detailCard = document.getElementById("detail-card-container");
            if (detailCard) {
                detailCard.classList.remove(
                    "damage-recoil-left",
                    "damage-recoil-right",
                );
            }
            setTimeout(() => {
                if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
            }, 700);
        });
    }

    setupMurderMysteryAssassination();
    document.addEventListener(
        "astro:page-load",
        setupMurderMysteryAssassination,
    );
</script>

