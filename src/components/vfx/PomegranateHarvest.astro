---
// Easter Egg Interattivo: Raccolta dei Melograni di Limbo
interface Props {
  imageSrc?: string;
}

const { imageSrc = "/images/pomegranate.png" } = Astro.props;
---

<!-- Contenitore ancorato al documento per seguire lo scroll naturale della pagina -->
<div 
  id="pomegranate-stage" 
  data-img-src={imageSrc}
  class="absolute inset-x-0 top-0 pointer-events-none z-30 hidden xl:block select-none"
>
  <!-- I melograni verranno generati dinamicamente dal ciclo vitale JavaScript -->
</div>

<script>
  function initPomegranateHarvest() {
    const stage = document.getElementById('pomegranate-stage') as HTMLElement;
    if (!stage) return;

    const imgSrc = stage.getAttribute('data-img-src') || '/images/pomegranate.png';
    let activeFruits = 0;

    function spawnBatch() {
      stage.innerHTML = '';

      // Calcola la posizione assoluta e la larghezza reale dello spazio laterale disponibile
        const detailCard = document.getElementById('detail-card-container');
        const cardRect = detailCard ? detailCard.getBoundingClientRect() : null;
        const pageTop = cardRect ? (cardRect.top + window.scrollY) : (window.scrollY + 350);
        const cardHeight = cardRect ? Math.max(cardRect.height, 650) : 700;

        // Larghezza reale in pixel della corsia laterale tra bordo schermo e scheda centrale
        const screenW = window.innerWidth;
        const gutterWidth = cardRect ? cardRect.left : Math.max(80, (screenW - 1280) / 2);

        const FRUIT_COUNT = 10; // 5 a sinistra e 5 a destra (+2 per lato)
        const sideCount = FRUIT_COUNT / 2;
        activeFruits = FRUIT_COUNT;

        for (let i = 0; i < FRUIT_COUNT; i++) {
          const isLeft = i < sideCount;
          const indexInSide = i % sideCount;
          const fruit = document.createElement('div');
          fruit.className = 'pomegranate-fruit';

          // 1. Scala casuale: da 1.0x (minimo) a 2.2x (più del doppio)
          const scale = (Math.random() * 1.2 + 1.0).toFixed(2);
          const approxFruitWidth = 64 * parseFloat(scale);

          // 2. DISPERSIONE ORIZZONTALE LIBERA: sfrutta tutta la larghezza della corsia
          const minOffset = 18; // Distanza minima dal bordo dello schermo
          const maxOffset = Math.max(minOffset + 40, gutterWidth - approxFruitWidth - 15);
          const randomX = Math.floor(Math.random() * (maxOffset - minOffset) + minOffset);

          // 3. DISPERSIONE VERTICALE DISORDINATA: spezza ogni linearità
          const segmentHeight = cardHeight / sideCount;
          const verticalJitter = (Math.random() * 0.9 - 0.45) * segmentHeight;
          const topPx = pageTop + (indexInSide * segmentHeight) + (segmentHeight * 0.35) + verticalJitter;

          // 4. Inclinazione organica accentuata
          const baseRot = (Math.random() * 70 - 35).toFixed(1); // Da -35deg a +35deg
          const swayDuration = (Math.random() * 2 + 3.5).toFixed(1);
          const swayDelay = (Math.random() * -4).toFixed(1);

          fruit.style.setProperty('--base-rot', `${baseRot}deg`);
          fruit.style.setProperty('--sway-duration', `${swayDuration}s`);
          fruit.style.setProperty('--sway-delay', `${swayDelay}s`);

          if (isLeft) {
            fruit.style.left = `${randomX}px`;
          } else {
            fruit.style.right = `${randomX}px`;
          }
          fruit.style.top = `${topPx}px`;

        // 4. Immagine con ombra volumetrica potenziata per i frutti più grandi
        fruit.innerHTML = `
          <img 
            src="${imgSrc}" 
            alt="Melograno Magico di Limbo" 
            class="fruit-img w-14 h-14 sm:w-16 sm:h-16 object-contain pointer-events-auto cursor-pointer drop-shadow-[0_12px_24px_rgba(244,63,94,0.35)] transition-transform hover:scale-115 active:scale-95" 
            style="transform: scale(${scale});"
            draggable="false"
          />
        `;

        // 4. Click: Caduta del frutto simulando la gravità con velocità angolare casuale
        fruit.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          if (!target || target.classList.contains('falling')) return;

          target.classList.add('falling');

          // Fisica casuale di caduta
          const spinDeg = (Math.random() * 360 + 200) * (Math.random() > 0.5 ? 1 : -1);
          const driftX = (Math.random() * 60 - 30); // Leggera deriva orizzontale
          const fallDuration = (Math.random() * 0.35 + 0.95).toFixed(2); // Tra 0.95s e 1.30s

          target.style.setProperty('--drift-x', `${driftX}px`);
          target.style.setProperty('--spin-deg', `${spinDeg}deg`);
          target.style.setProperty('--fall-duration', `${fallDuration}s`);

          // A fine caduta rimuoviamo l'elemento
          target.addEventListener('animationend', () => {
            target.remove();
            activeFruits--;

            // Se sono caduti tutti, avvia un nuovo ciclo di crescita
            // Se l'ultimo melograno è caduto ed è uscito, innesca l'onda d'urto
            if (activeFruits <= 0) {
                window.dispatchEvent(new CustomEvent('pomegranate:detonate'));
            }
          }, { once: true });
        });

        stage.appendChild(fruit);
      }
    }

    // Funzione per ripulire e far sparire i melograni con dissolvenza rapida
    function clearStage() {
      const existing = stage.querySelectorAll('.pomegranate-fruit');
      existing.forEach((el) => {
        (el as HTMLElement).style.transition = 'opacity 0.35s ease-out, transform 0.35s ease-out';
        (el as HTMLElement).style.opacity = '0';
        (el as HTMLElement).style.transform = 'scale(0.5)';
        setTimeout(() => el.remove(), 350);
      });
      activeFruits = 0;
    }

    // In ascolto degli eventi contestuali di Pomegranade: Limbo
    window.addEventListener('pomegranate:spawn', () => {
      clearStage();
      setTimeout(spawnBatch, 200);
    });

    window.addEventListener('pomegranate:clear', () => {
      clearStage();
    });
  }

  initPomegranateHarvest();
  document.addEventListener('astro:page-load', initPomegranateHarvest);
</script>

<style is:global>
  /* 1. CRESCITA ORGANICA DALL'ALBERO (Pop & Plump) */
  @keyframes fruitGrow {
    0% {
      transform: scale(0) rotate(var(--base-rot));
      opacity: 0;
    }
    60% {
      transform: scale(1.15) rotate(calc(var(--base-rot) + 4deg));
      opacity: 1;
    }
    85% {
      transform: scale(0.95) rotate(calc(var(--base-rot) - 2deg));
    }
    100% {
      transform: scale(1) rotate(var(--base-rot));
      opacity: 1;
    }
  }

  /* 2. OSCILLAZIONE LIEVE AL VENTO */
  @keyframes fruitWindSway {
    0%, 100% {
      transform: rotate(var(--base-rot));
    }
    50% {
      transform: rotate(calc(var(--base-rot) + 5deg)) translateY(-3px);
    }
  }

  /* 3. CADUTA GRAVITAZIONALE CON ROTAZIONE FISICA */
  @keyframes fruitGravityFall {
    0% {
      transform: translate3d(0, 0, 0) rotate(var(--base-rot));
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
        transform: translate3d(var(--drift-x, 0px), 800px, 0) rotate(var(--spin-deg, 360deg));
        opacity: 0;
    }
  }

  .pomegranate-fruit {
    position: absolute;
    animation: 
      fruitGrow 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      fruitWindSway var(--sway-duration, 4s) ease-in-out infinite 0.85s;
    will-change: transform, opacity;
  }

  .pomegranate-fruit.falling {
    animation: fruitGravityFall var(--fall-duration, 1.1s) cubic-bezier(0.55, 0.055, 0.675, 0.19) forwards !important;
    pointer-events: none !important;
  }
</style>