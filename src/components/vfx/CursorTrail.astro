---
// Effetto Plasma Wake / Laser Incisione su Canvas 2D
---

<canvas id="cursor-trail-canvas" class="fixed inset-0 pointer-events-none z-40"></canvas>

<script>
  interface TrailPoint {
    x: number;
    y: number;
    age: number;
  }

  // Verifica che il dispositivo abbia un mouse di precisione (non solo touch)
  const isFinePointer = window.matchMedia('(pointer: fine)').matches;

  const canvas = document.getElementById('cursor-trail-canvas') as HTMLCanvasElement | null;

  if (canvas && isFinePointer) {
    const ctx = canvas.getContext('2d');
    let points: TrailPoint[] = [];
    let isRunning = false;
    const maxAge = 20; // Circa 330ms a 60fps (dissolvenza rapida)

    // Adatta il canvas alla risoluzione fisica del display (HiDPI / Retina)
    function resizeCanvas() {
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx?.scale(dpr, dpr);
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Distanza minima in pixel tra due campioni per evitare addensamenti di luce
    const MIN_DISTANCE = 4;

    window.addEventListener('pointermove', (e: PointerEvent) => {
      const events = typeof e.getCoalescedEvents === 'function' ? e.getCoalescedEvents() : [e];
      
      for (let i = 0; i < events.length; i++) {
        const last = points[points.length - 1];
        const ex = events[i].clientX;
        const ey = events[i].clientY;

        // Inserisce il punto solo se c'è un effettivo avanzamento spaziale
        if (!last || Math.hypot(ex - last.x, ey - last.y) >= MIN_DISTANCE) {
          points.push({ x: ex, y: ey, age: 0 });
        }
      }

      if (!isRunning) {
        isRunning = true;
        requestAnimationFrame(render);
      }
    });

    function render() {
      if (!ctx || !canvas) return;

      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

      // Invecchiamento dei punti
      for (let i = 0; i < points.length; i++) {
        points[i].age++;
      }
      points = points.filter((p) => p.age < maxAge);

      if (points.length < 3) {
        isRunning = false;
        return;
      }

      // Giunti piatti per eliminare l'accumulo di luce sui vertici di raccordo
      ctx.lineCap = 'butt';
      ctx.lineJoin = 'round';
      ctx.globalCompositeOperation = 'lighter';

      for (let i = 1; i < points.length; i++) {
        const pPrev = points[i - 1];
        const pCurr = points[i];

        const startX = i === 1 ? pPrev.x : (points[i - 2].x + pPrev.x) / 2;
        const startY = i === 1 ? pPrev.y : (points[i - 2].y + pPrev.y) / 2;
        
        const isLast = i === points.length - 1;
        const endX = isLast ? pCurr.x : (pPrev.x + pCurr.x) / 2;
        const endY = isLast ? pCurr.y : (pPrev.y + pCurr.y) / 2;

        const progress = i / points.length;
        const taper = Math.pow(progress, 1.3);
        const lifeAlpha = (1 - pCurr.age / maxAge) * progress;

        if (lifeAlpha <= 0) continue;

        // Disegno a filo continuo senza sovrapposizioni
        const strokeBeam = (color: string, width: number) => {
          if (!ctx) return;
          ctx.beginPath();
          ctx.moveTo(startX, startY);
          ctx.quadraticCurveTo(pPrev.x, pPrev.y, endX, endY);
          ctx.strokeStyle = color;
          ctx.lineWidth = width;
          ctx.stroke();
        };

        strokeBeam(`rgba(147, 51, 234, ${lifeAlpha * 0.4})`, Math.max(1, taper * 10));
        strokeBeam(`rgba(56, 189, 248, ${lifeAlpha * 0.7})`, Math.max(0.8, taper * 5));
        strokeBeam(`rgba(255, 255, 255, ${lifeAlpha * 0.95})`, Math.max(0.5, taper * 1.8));

        // Solo sulla punta estrema del cursore disegniamo il nucleo sferico incandescente
        if (isLast) {
          ctx.beginPath();
          ctx.arc(pCurr.x, pCurr.y, Math.max(1, taper * 1.2), 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
          ctx.fill();
        }
      }

      ctx.globalCompositeOperation = 'source-over';
      requestAnimationFrame(render);
    }
  }
</script>