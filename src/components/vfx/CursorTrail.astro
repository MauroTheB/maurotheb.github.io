---
// Effetto Plasma Wake / Laser Incisione su Canvas 2D (Allineamento Perfetto a Qualsiasi Zoom)
---

<canvas id="cursor-trail-canvas" class="fixed inset-0 pointer-events-none z-40 w-full h-full"></canvas>

<script>
  interface TrailPoint {
    x: number;
    y: number;
    age: number;
  }

  const isFinePointer = window.matchMedia('(pointer: fine)').matches;
  const canvas = document.getElementById('cursor-trail-canvas') as HTMLCanvasElement | null;

  if (canvas && isFinePointer) {
    const ctx = canvas.getContext('2d');
    let points: TrailPoint[] = [];
    let isRunning = false;
    const maxAge = 20;
    const MIN_DISTANCE = 4;

    // Calibra il canvas ad alta definizione (Retina / 4K / Zoom del browser)
    function resizeCanvas() {
      if (!canvas || !ctx) return;
      const dpr = window.devicePixelRatio || 1;
      const w = window.innerWidth;
      const h = window.innerHeight;

      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;

      // Applica la matrice di scala nativa per annullare l'offset da zoom
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (!canvas) return;

      // Auto-Detect Zoom: se l'utente ha zoomato con Ctrl +/-, ricalibra istantaneamente
      const expectedWidth = Math.round(window.innerWidth * (window.devicePixelRatio || 1));
      if (canvas.width !== expectedWidth) {
        resizeCanvas();
      }

      const events = typeof e.getCoalescedEvents === 'function' ? e.getCoalescedEvents() : [e];

      for (let i = 0; i < events.length; i++) {
        // Coordinate dirette 1:1 con la freccia del mouse
        const ex = events[i].clientX;
        const ey = events[i].clientY;

        const last = points[points.length - 1];

        if (!last || Math.hypot(ex - last.x, ey - last.y) >= MIN_DISTANCE) {
          points.push({ x: ex, y: ey, age: 0 });
        }
      }

      if (!isRunning) {
        isRunning = true;
        requestAnimationFrame(render);
      }
    });

    function render() {
      if (!ctx || !canvas) return;

      // Pulisce l'area visibile in coordinate viewport
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

      for (let i = 0; i < points.length; i++) {
        points[i].age++;
      }
      points = points.filter((p) => p.age < maxAge);

      if (points.length < 3) {
        isRunning = false;
        return;
      }

      ctx.lineCap = 'butt';
      ctx.lineJoin = 'round';
      ctx.globalCompositeOperation = 'lighter';

      for (let i = 1; i < points.length; i++) {
        const pPrev = points[i - 1];
        const pCurr = points[i];

        const startX = i === 1 ? pPrev.x : (points[i - 2].x + pPrev.x) / 2;
        const startY = i === 1 ? pPrev.y : (points[i - 2].y + pPrev.y) / 2;
        
        const isLast = i === points.length - 1;
        const endX = isLast ? pCurr.x : (pPrev.x + pCurr.x) / 2;
        const endY = isLast ? pCurr.y : (pPrev.y + pCurr.y) / 2;

        const progress = i / points.length;
        const taper = Math.pow(progress, 1.3);
        const lifeAlpha = (1 - pCurr.age / maxAge) * progress;

        if (lifeAlpha <= 0) continue;

        const strokeBeam = (color: string, width: number) => {
          if (!ctx) return;
          ctx.beginPath();
          ctx.moveTo(startX, startY);
          ctx.quadraticCurveTo(pPrev.x, pPrev.y, endX, endY);
          ctx.strokeStyle = color;
          ctx.lineWidth = width;
          ctx.stroke();
        };

        strokeBeam(`rgba(147, 51, 234, ${lifeAlpha * 0.4})`, Math.max(1, taper * 10));
        strokeBeam(`rgba(56, 189, 248, ${lifeAlpha * 0.7})`, Math.max(0.8, taper * 5));
        strokeBeam(`rgba(255, 255, 255, ${lifeAlpha * 0.95})`, Math.max(0.5, taper * 1.8));

        // Punta incandescente centrata
        if (isLast) {
          ctx.beginPath();
          ctx.arc(pCurr.x, pCurr.y, Math.max(1, taper * 1.2), 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
          ctx.fill();
        }
      }

      ctx.globalCompositeOperation = 'source-over';
      requestAnimationFrame(render);
    }
  }
</script>