---
interface Props {
  projectId: string;
}

const { projectId } = Astro.props;
---

{projectId === 'puppeteer' && (
  <div class="card-breakout-frame pointer-events-none select-none">
    
    <!-- 1. LIVELLO BACK PUPPETEER (z-0: sta fisicamente DIETRO allo sfondo della card) -->
    <div class="absolute -top-25 -left-30 -right-20 h-230 z-0 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/rovi_inferiori.png" 
        alt="Pomegranade Frame Back" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_20px_rgba(0,0,0,0.9)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>
    
    <!-- CORNICE SUPERIORE A TUTTA LARGHEZZA (Altezza controllata h-20) -->
    <div class="absolute -top-25 -left-30 -right-20 h-230 z-30 overflow-visible pointer-events-none">
      <img 
        src="/images/rovi_superiori.png" 
        alt="Rovi Superiori" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.95)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>

  </div>
)}

{projectId === 'pomegranade' && (
  <>
    <!-- 1. LIVELLO BACK POMEGRANADE (z-0: sta fisicamente DIETRO allo sfondo della card) -->
    <div class="absolute -top-25 -left-45 -right-20 h-260 z-0 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/pomegranade_back.png" 
        alt="Pomegranade Frame Back" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_20px_rgba(0,0,0,0.9)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>

    <!-- 2. LIVELLO FRONT POMEGRANADE (z-30: avvolge DAVANTI ai bordi e contenuti) -->
    <div class="absolute -top-25 -left-35 -right-20 h-250 z-30 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/pomegranade_front.png" 
        alt="Pomegranade Frame Front" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.95)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>
  </>
)}

{projectId === 'murder-mystery' && (
  <>
    <!-- 1. LIVELLO BACK MURDER MYSTERY (z-0) -->
    <div class="absolute -top-20 -left-30 -right-20 h-225 z-0 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/murder_back.png" 
        alt="Murder Mystery Frame Back" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_20px_rgba(0,0,0,0.9)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>

    <!-- 2. LIVELLO FRONT MURDER MYSTERY (z-30) -->
    <div class="absolute -top-30 -left-30 -right-20 h-225 z-30 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/murder_front.png" 
        alt="Murder Mystery Frame Front" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.95)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>
  </>
)}

{projectId === 'water-sim' && (
  <>
    <!-- 1. LIVELLO BACK WATER SIMULATION (z-0) -->
    <div class="absolute -top-30 -left-20 -right-10 h-240 z-0 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/water_back.png" 
        alt="Water Simulation Frame Back" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_20px_rgba(0,0,0,0.9)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>

    <!-- 2. LIVELLO FRONT WATER SIMULATION (z-30) -->
    <div class="absolute -top-30 -left-20 -right-10 h-240 z-30 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/water_front.png" 
        alt="Water Simulation Frame Front" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.95)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>
  </>
)}

{projectId === 'mazes-soul' && (
  <>
    <!-- 1. LIVELLO BACK MAZE'S SOUL (z-0) -->
    <div class="absolute -top-33 -left-30 -right-20 h-207 z-0 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/maze_back.png" 
        alt="Maze's Soul Frame Back" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_20px_rgba(0,0,0,0.9)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>

    <!-- 2. LIVELLO FRONT MAZE'S SOUL (z-30) -->
    <div class="absolute -top-30 -left-20 -right-20 h-207 z-30 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/maze_front.png" 
        alt="Maze's Soul Frame Front" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.95)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>
  </>
)}

{projectId === 'dda-thesis' && (
  <>
    <!-- 1. LIVELLO BACK DDA (z-0) -->
    <div class="absolute -top-20 -left-10-right-10 h-225 z-0 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/dda_back.png" 
        alt="DDA Frame Back" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_20px_rgba(0,0,0,0.9)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>

    <!-- 2. LIVELLO FRONT DDA (z-30) -->
    <div class="absolute -top-20 -left-10 -right-10 h-235 z-30 overflow-visible pointer-events-none select-none">
      <img 
        src="/images/dda_front.png" 
        alt="DDA Frame Front" 
        class="w-full h-full object-fill filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.95)] group-hover:scale-102 transition-transform duration-700 ease-out"
        draggable="false"
      />
    </div>
  </>
)}