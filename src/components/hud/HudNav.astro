---
import { getPortfolio, type Locale } from '../../data/portfolio';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const { ui: UI } = getPortfolio(lang);
---

<!-- 1. Markup Barra HUD -->
<nav class="sticky top-6 z-50 max-w-5xl mx-auto px-6 my-10">
  <div class="bg-slate-900/90 border border-slate-800 backdrop-blur-2xl p-2 rounded-2xl sm:rounded-3xl shadow-2xl flex flex-wrap items-center justify-between gap-2">
    <button 
      data-target="projects" 
      class="hud-btn flex-1 min-w-[150px] py-3.5 px-5 rounded-xl sm:rounded-2xl text-sm sm:text-base font-mono font-bold transition flex items-center justify-center gap-2.5 bg-violet-600 text-white shadow-lg shadow-violet-600/30"
    >
      <span class="text-lg">🎮</span>
      <span>{UI.hudProjects}</span>
    </button>
    <button 
      data-target="experience" 
      class="hud-btn flex-1 min-w-[150px] py-3.5 px-5 rounded-xl sm:rounded-2xl text-sm sm:text-base font-mono font-bold text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 transition flex items-center justify-center gap-2.5"
    >
      <span class="text-lg">💼</span>
      <span>{UI.hudExperience}</span>
    </button>
    <button 
      data-target="education" 
      class="hud-btn flex-1 min-w-[150px] py-3.5 px-5 rounded-xl sm:rounded-2xl text-sm sm:text-base font-mono font-bold text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 transition flex items-center justify-center gap-2.5"
    >
      <span class="text-lg">🎓</span>
      <span>{UI.hudEducation}</span>
    </button>
    <button 
      data-target="skills" 
      class="hud-btn flex-1 min-w-[150px] py-3.5 px-5 rounded-xl sm:rounded-2xl text-sm sm:text-base font-mono font-bold text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 transition flex items-center justify-center gap-2.5"
    >
      <span class="text-lg">⚡</span>
      <span>{UI.hudSkills}</span>
    </button>
  </div>
</nav>

<!-- 2. Logica di Transizione Asincrona tra Tracce -->
<script>
  const buttons = document.querySelectorAll('.hud-btn');

  let isTransitioning = false;

  buttons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = `track-${btn.getAttribute('data-target')}`;
      const currentSection = document.querySelector('.track-section:not(.hidden)');
      const targetSection = document.getElementById(targetId);

      // Evita click multipli o click sulla stessa traccia già attiva
      if (!targetSection || currentSection === targetSection || isTransitioning) return;

      isTransitioning = true;

      // 1. Aggiorna stile visivo dei pulsanti HUD
      buttons.forEach((b) => {
        b.classList.remove('bg-violet-600', 'text-white', 'shadow-lg', 'shadow-violet-600/30');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('bg-violet-600', 'text-white', 'shadow-lg', 'shadow-violet-600/30');
      btn.classList.remove('text-slate-400');

      // 2. Transizione di uscita (Warp Out)
      if (currentSection) {
        currentSection.classList.add('track-exit');
        await new Promise((resolve) => setTimeout(resolve, 180));
        currentSection.classList.add('hidden');
        currentSection.classList.remove('track-exit');
      }

      // 3. Transizione di entrata a cascata (Staggered Assemble)
      targetSection.classList.remove('hidden');
      targetSection.classList.add('track-enter');

      setTimeout(() => {
        targetSection.classList.remove('track-enter');
        isTransitioning = false;
      }, 450);
    });
  });
</script>

<!-- 3. Stili di Transizione Tracce (Globali per agire sulle sezioni) -->
<style is:global>
  @keyframes trackExit {
    0% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0px);
    }
    100% {
      opacity: 0;
      transform: scale(0.97) translateY(-8px);
      filter: blur(4px);
    }
  }

  @keyframes cardAssemble {
    0% {
      opacity: 0;
      transform: translateY(20px) scale(0.96);
      filter: blur(3px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
  }

  .track-exit {
    animation: trackExit 0.18s cubic-bezier(0.4, 0, 1, 1) forwards;
    pointer-events: none;
  }

  .track-enter > * {
    animation: cardAssemble 0.38s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .track-enter > *:nth-child(1) { animation-delay: 0.02s; }
  .track-enter > *:nth-child(2) { animation-delay: 0.08s; }
  .track-enter > *:nth-child(3) { animation-delay: 0.14s; }
  .track-enter > *:nth-child(4) { animation-delay: 0.20s; }
</style>