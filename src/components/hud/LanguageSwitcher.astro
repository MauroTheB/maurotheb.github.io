---
import type { Locale } from '../../data/portfolio';

interface Props {
  currentLang?: Locale;
}

const { currentLang = 'en' } = Astro.props;
---

<aside class="fixed top-5 right-5 z-50 flex items-center p-1 rounded-full bg-slate-900/80 border border-white/15 backdrop-blur-xl shadow-2xl">
  <a
    href="/"
    class={`flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium transition-all duration-200 ${
      currentLang === 'en'
        ? 'bg-violet-600 text-white shadow-md shadow-violet-600/30 font-bold'
        : 'text-slate-400 hover:text-white'
    }`}
  >
    <span>🇬🇧</span>
    <span>EN</span>
  </a>
  <a
    href="/it/"
    class={`flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium transition-all duration-200 ${
      currentLang === 'it'
        ? 'bg-violet-600 text-white shadow-md shadow-violet-600/30 font-bold'
        : 'text-slate-400 hover:text-white'
    }`}
  >
    <span>🇮🇹</span>
    <span>IT</span>
  </a>
</aside>