---
import CardThematicFrame from '../vfx/CardThematicFrame.astro';

interface Props {
  proj: any; // Usiamo any per ora per retrocompatibilità, poi tipizzeremo
  lang: 'en' | 'it'| 'fr';
  UI: Record<string, string>;
  textPadding: string;
  fallbackCover?: string;
}

const { proj, lang, UI, textPadding, fallbackCover = '/images/puppeteer_immagine1.png' } = Astro.props;
---

<article 
  data-project-card={proj.id}
  data-project-video={proj.videoUrl || ''}
  data-project-description={proj.description}
  data-project-tagline={proj.genrePlatform || proj.tagline}
  data-project-role={proj.role}
  data-project-tags={proj.tags?.join('||') || ''}
  class="interactive-card relative bg-slate-900/70 border border-slate-800 rounded-3xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 group hover:shadow-2xl hover:shadow-violet-500/15 hover:-translate-y-1 backdrop-blur-md"
>
  <!-- Cornice Tematica (Rovi/Simulazione/ecc) -->
  <CardThematicFrame projectId={proj.id} />

  <!-- Superficie Vetro Semitrasparente -->
  <div class="absolute inset-0 rounded-3xl bg-slate-900/70 group-hover:bg-slate-900/45 backdrop-blur-md z-0 pointer-events-none transition-colors duration-1000"></div>

  <!-- Contenitore Testi (z-40: SOPRA a tutto, inclusi i rovi che sono z-30) -->
<div class={`relative z-40 flex flex-col justify-between h-full ${textPadding}`}>
    <div class="relative z-10">
      
      <!-- Tag Tech (z-40: devono essere sopra i rovi) -->
    <div class="relative z-40 flex flex-wrap justify-center gap-1.5 mb-4 drop-shadow-[0_4px_8px_rgba(0,0,0,0.95)]">
        {proj.tags?.slice(0, 4).map((tag: string) => (
          <span class="px-2.5 py-1 rounded-md bg-slate-800/95 text-cyan-300 text-[11px] font-mono border border-slate-700/60 shadow-lg">
            {tag}
          </span>
        ))}
      </div>

      <!-- Banner -->
      {proj.coverImage && (
        <div class="relative z-10 aspect-video w-full rounded-2xl overflow-hidden mb-5 bg-slate-950 border border-slate-800/80 shadow-inner group-hover:border-slate-700 transition-colors">
          <img 
           src={proj.coverImage || fallbackCover}
            alt={proj.title}
            onerror={`this.onerror=null;this.src='${fallbackCover}';`}
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
        </div>
      )}

      <!-- Header Info -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-400/90">
          {proj.category}
        </span>
        {proj.highlight && (
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-300 text-[11px] font-mono">
            <span>★</span>
            <span>{proj.highlight}</span>
          </div>
        )}
      </div>

      <!-- Titolo & Anno -->
      <div class="flex items-baseline justify-between gap-3 mb-1">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white group-hover:text-violet-300 transition">
          {proj.title}
        </h3>
        <span class="text-xs font-mono text-slate-500 font-semibold">{proj.year || proj.period}</span>
      </div>

      <p class="text-xs font-mono text-cyan-400 mb-3 font-medium">{proj.genrePlatform || proj.tagline}</p>
      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4 line-clamp-3">{proj.gameplaySummary || proj.description}</p>

      {proj.personalContributionSummary && (
        <div class="border-l-2 border-violet-500/60 pl-3 py-1 mb-6 bg-slate-950/40 rounded-r-lg shadow-lg">
          <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold block mb-0.5">{lang === 'it' ? 'Contributo Personale:' : lang === 'fr' ? 'Contribution Clé :' : 'Key Contribution:'}
            
          </span>
          <span class="text-xs font-mono font-bold text-violet-300 block">{proj.primaryFocus || proj.role}</span>
        </div>
      )}
    </div>

    <!-- CTA (z-40: sopra i rovi) -->
    <div class="relative z-40 pt-4 border-t border-slate-800/60 flex items-center justify-center gap-2 mt-auto">
      <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-mono font-bold text-violet-400 group-hover:text-violet-300 group-hover:scale-105 transition-all">
        <span>{UI.exploreProject}</span>
        <span class="group-hover:translate-x-1 transition-transform text-base">→</span>
      </div>
    </div>
  </div>
</article>