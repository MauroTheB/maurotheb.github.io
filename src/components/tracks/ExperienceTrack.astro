---
import { EXPERIENCES } from '../../data/portfolio';
---

<!-- TRACCIA 2: ESPERIENZE -->
<section id="track-experience" class="track-section hidden space-y-12">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">Esperienze Lavorative</h2>
    <p class="text-slate-400 text-base sm:text-lg mt-3 font-mono">Docenza accademica, sviluppo su motori proprietari e produzione Unity.</p>
  </div>

  <div class="space-y-8 max-w-4xl mx-auto">
    {EXPERIENCES.map((exp) => (
      <div class="relative pl-8 sm:pl-10 border-l-2 border-slate-800 hover:border-violet-500 transition py-2">
        <span class="absolute -left-[9px] top-6 w-4 h-4 rounded-full bg-slate-950 border-2 border-violet-500"></span>
        
        <div class="bg-slate-900/70 border border-slate-800 p-8 sm:p-10 rounded-3xl backdrop-blur-md shadow-xl">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-xl sm:text-2xl font-bold text-white">{exp.role}</h3>
            <span class="text-sm font-mono text-slate-400">{exp.period}</span>
          </div>
          
          <div class="text-base font-mono text-violet-400 mt-1 mb-4">{exp.company} • {exp.location}</div>
          
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-6">
            {exp.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {exp.skills.map((skill) => (
              <span class="px-3 py-1 rounded-lg bg-slate-800 text-slate-400 text-xs sm:text-sm font-mono">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>