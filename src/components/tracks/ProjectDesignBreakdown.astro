---
import type { DesignFeatureSection } from '../../data/portfolio';

interface Props {
  features: DesignFeatureSection[];
  isMobile?: boolean;
  lang?: 'en' | 'it'| 'fr';
}

const { features, isMobile = false, lang = 'en' } = Astro.props;
const labels = {
  heading: lang === 'it' ? 'Breakdown di Design & Sistemi' : lang === 'fr' ? 'Breakdown Design & Systèmes' : 'Design & Systems Breakdown',
  jumpHint: lang === 'it' ? 'Vai alla sezione:' : lang === 'fr' ? 'Accès rapide :' : 'Jump to section:',
  whatWhy: lang === 'it' ? 'Cosa & Perché' : lang === 'fr' ? 'Quoi & Pourquoi' : 'What & Why',
  processToggle: lang === 'it' ? 'Processo, regole & iterazioni di design' : lang === 'fr' ? 'Processus, règles & itérations de design' : 'Design process, tuning & iterations',
  ideation: lang === 'it' ? 'Ideazione & Trade-off' : lang === 'fr' ? 'Idéation & Compromis' : 'Ideation & Trade-offs',
  tuning: lang === 'it' ? 'Meccaniche & Parametri' : lang === 'fr' ? 'Mécaniques & Équilibrage' : 'Mechanics & Tuning',
  iteration: lang === 'it' ? 'Playtest & Risultati' : lang === 'fr' ? 'Playtests & Résultats' : 'Playtest & Results',
  mediaQueued: lang === 'it' ? 'Acquisizione Media // In Aggiornamento' : lang === 'fr' ? 'Capture Visuelle // Mise à jour en cours' : 'Visual Capture // Archive Updating',
};
---

<div class="design-breakdown space-y-6 pt-2">
  <div class="rounded-2xl bg-slate-950/55 border border-slate-800/80 p-4 sm:p-5 space-y-3.5">
    <div class="flex flex-wrap items-center justify-center sm:justify-between gap-2 text-center sm:text-left">
      <h4 class="text-xs sm:text-sm font-mono uppercase text-slate-300 tracking-wider font-bold">
        {labels.heading}
      </h4>
      <span class="text-[11px] font-mono text-slate-400">{labels.jumpHint}</span>
    </div>

    <!-- Barra bottoni simmetrica e centrata su 1 o 2 righe, con tinta viola/cyan coerente col sito -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
      {features.map((feat, idx) => (
        <button
          type="button"
          data-scroll-target={feat.id || `feature-${idx}`}
          class="group/jump inline-flex items-center justify-center gap-2.5 px-4 py-2.5 rounded-xl bg-gradient-to-r from-violet-600/20 to-cyan-500/15 hover:from-violet-600/35 hover:to-cyan-500/25 border border-violet-400/35 hover:border-cyan-400/80 text-xs sm:text-sm font-mono font-semibold text-white hover:text-cyan-100 shadow-lg shadow-violet-950/40 hover:shadow-[0_0_24px_-4px_rgba(34,211,238,0.4)] hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 group-hover/jump:scale-125 transition-transform shrink-0"></span>
          <span>{feat.discipline}</span>
          <span class="text-cyan-300/90 group-hover/jump:translate-y-0.5 transition-transform text-xs shrink-0">↓</span>
        </button>
      ))}
    </div>
  </div>

  <div class="space-y-6">
    {features.map((feat, idx) => (
      <article
        id={feat.id || `feature-${idx}`}
        class="breakdown-card rounded-3xl bg-slate-950/85 border border-slate-800/90 hover:border-cyan-500/40 p-5 sm:p-7 backdrop-blur-xl shadow-2xl transition-all duration-500 ease-out"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <!-- MEDIA (20s): sempre visibile -->
          <div class="lg:col-span-5 space-y-2">
            <div class={`group/img relative overflow-hidden bg-slate-900 border border-slate-800/90 ${
              isMobile
                ? 'aspect-[9/16] max-w-[240px] sm:max-w-[260px] mx-auto rounded-[1.8rem] border-2 border-slate-700/80 shadow-2xl'
                : 'aspect-video w-full rounded-2xl'
              }`}>
               {feat.media.type === 'video' && feat.media.src ? (
                <video
                  src={feat.media.src}
                  autoplay
                  muted
                  loop
                  playsinline
                  class={`w-full h-full ${isMobile ? 'object-contain bg-slate-950' : 'object-cover'}`}
                />
              
               ) : feat.media.type === 'placeholder' || !feat.media.src ? (
                <div class="w-full h-full flex flex-col items-center justify-center p-5 text-center bg-slate-950 bg-[radial-gradient(rgba(34,211,238,0.12)_1px,transparent_1px)] [background-size:16px_16px]">
                  <div class="w-10 h-10 rounded-xl bg-slate-900/90 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-3 shadow-lg">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5A2.25 2.25 0 0 1 5.25 5.25h3.379a1.5 1.5 0 0 1 1.06.44l1.122 1.12a1.5 1.5 0 0 0 1.06.44h6.879A2.25 2.25 0 0 1 21 9.5v7.25A2.25 2.25 0 0 1 18.75 19H5.25A2.25 2.25 0 0 1 3 16.75V7.5Z" />
                    </svg>
                  </div>
                  <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-[10px] font-mono uppercase tracking-widest text-cyan-300 font-bold mb-2">
                    {labels.mediaQueued}
                  </span>
                  <p class="text-xs sm:text-sm font-mono text-slate-300 max-w-xs leading-snug">
                    {feat.media.alt || feat.title}
                  </p>
                </div>
              ) : (
                <>
                  <img
                    src={feat.media.src}
                    alt={feat.media.alt || feat.title}
                    data-zoomable
                    data-caption={feat.media.caption || ''}
                    loading="lazy"
                    class={`w-full h-full ${isMobile ? 'object-contain bg-slate-950' : 'object-cover'} cursor-zoom-in transition-transform duration-300 group-hover/img:scale-[1.02]`}
                  />
                  <span class="pointer-events-none absolute bottom-2.5 right-2.5 px-2 py-1 rounded-lg bg-slate-950/80 border border-white/15 text-[10px] font-mono text-slate-200 opacity-0 group-hover/img:opacity-100 transition-opacity duration-200 backdrop-blur-md">
                    ⤢ Zoom
                  </span>
                </>
              )}
            </div>
            {feat.media.caption && (
              <p class="text-[11px] font-mono text-slate-400 px-1">{feat.media.caption}</p>
            )}
          </div>

          <!-- TESTI (20s Header -> 1m Cosa/Perché -> 10m Processo) -->
          <div class="lg:col-span-7 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-md bg-cyan-500/10 border border-cyan-500/25 text-cyan-300 text-[11px] font-mono font-bold uppercase tracking-wider">
                {feat.discipline}
              </span>
              {feat.scopeBadge && (
                <span class="px-2.5 py-0.5 rounded-full bg-violet-500/10 border border-violet-500/30 text-violet-300 text-[11px] font-mono">
                  {feat.scopeBadge}
                </span>
              )}
            </div>

            <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
              {feat.title}
            </h3>

            <!-- Livello 1m -->
            <div class="space-y-1">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 font-bold block">
                {labels.whatWhy}
              </span>
              <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
                {feat.whatAndWhy}
              </p>
            </div>

            <!-- Livello 10m -->
            {feat.processDetails && (
              <details class="group/det rounded-2xl bg-slate-900/60 border border-slate-800/80 px-4 py-3">
                <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-mono font-bold text-violet-300 hover:text-violet-200 select-none">
                  <span>{labels.processToggle}</span>
                  <span class="transition-transform duration-300 group-open/det:rotate-180">▾</span>
                </summary>

                <div class="pt-3 mt-3 border-t border-slate-800/70 space-y-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
                  {feat.processDetails.ideation && (
                    <div>
                      <strong class="text-cyan-400 font-mono text-[11px] uppercase block mb-0.5">{labels.ideation}</strong>
                      <p>{feat.processDetails.ideation}</p>
                    </div>
                  )}
                  {feat.processDetails.mechanicsOrTuning?.length && (
                    <div>
                      <strong class="text-cyan-400 font-mono text-[11px] uppercase block mb-1">{labels.tuning}</strong>
                      <ul class="space-y-1 font-mono text-xs">
                        {feat.processDetails.mechanicsOrTuning.map((item) => (
                          <li class="flex items-start gap-2">
                            <span class="text-cyan-500">›</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {feat.processDetails.iterationOrResult && (
                    <div>
                      <strong class="text-amber-300 font-mono text-[11px] uppercase block mb-0.5">{labels.iteration}</strong>
                      <p>{feat.processDetails.iterationOrResult}</p>
                    </div>
                  )}
                </div>
              </details>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  function setupBreakdownFocus() {
    const cards = document.querySelectorAll<HTMLElement>('.breakdown-card');
    document.querySelectorAll<HTMLButtonElement>('[data-scroll-target]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-scroll-target');
        if (!targetId) return;
        const target = btn.closest('.design-breakdown')?.querySelector<HTMLElement>(`[id="${targetId}"]`);
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
    if (!cards.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const el = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          el.classList.remove('opacity-70', 'blur-[1px]', 'scale-[0.99]');
          el.classList.add('opacity-100', 'blur-0', 'scale-100');
        } else {
          el.classList.add('opacity-70', 'blur-[1px]', 'scale-[0.99]');
          el.classList.remove('opacity-100', 'blur-0', 'scale-100');
        }
      });
    }, { threshold: 0.25 });

    cards.forEach((card) => observer.observe(card));
  }

  setupBreakdownFocus();
  document.addEventListener('astro:page-load', setupBreakdownFocus);
</script>