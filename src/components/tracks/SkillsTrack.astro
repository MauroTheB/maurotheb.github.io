---
import { getPortfolio, type Locale } from '../../data/portfolio';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const { skills: TECH_SKILLS, ui: UI } = getPortfolio(lang);
---

<!-- TRACCIA 4: COMPETENZE & TOOLING -->
<section id="track-skills" class="track-section hidden space-y-12">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">{UI.skillsHeading}</h2>
    <p class="text-slate-400 text-base sm:text-lg mt-3 font-mono">{UI.skillsSubheading}</p>
  </div>

  <!-- Griglia Skill Tree in 6 Pilastri (Responsive 1/2/3 colonne) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
        {TECH_SKILLS.map((cat) => (
          <div class="bg-slate-900/70 border border-slate-800/90 p-7 rounded-3xl flex flex-col justify-between backdrop-blur-md shadow-xl hover:border-violet-500/40 transition-all duration-300">
            <div class="space-y-4">
              <!-- Intestazione con Icona e Badge di Livello Competenza -->
              <div class="flex items-center justify-between gap-2 border-b border-slate-800/80 pb-3">
                <span class="text-xl">{cat.icon || "⚡"}</span>
                {cat.level && (
                  <span class="px-2.5 py-0.5 rounded-full bg-violet-500/10 border border-violet-500/25 text-violet-300 text-[10px] font-mono font-bold uppercase tracking-wider">
                    {cat.level}
                  </span>
                )}
              </div>

              <h3 class="text-base font-mono font-bold text-white tracking-tight">
                {cat.category}
              </h3>

              <!-- Lista Competenze Tecniche -->
              <ul class="space-y-2 pt-1 text-xs sm:text-sm text-slate-300 font-mono">
                {cat.items.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-violet-400 font-bold mt-0.5">›</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
</section>