---
import { PROFILE } from '../../data/portfolio';
---

<header class="relative min-h-[85vh] flex flex-col justify-center items-center px-6 text-center overflow-hidden border-b border-slate-900">
  <!-- Glow di sfondo dinamico -->
  <div class="absolute -top-40 w-[600px] h-[600px] bg-violet-600/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute -bottom-40 w-[500px] h-[500px] bg-cyan-600/10 rounded-full blur-[130px] pointer-events-none"></div>

  <!-- Badge di stato -->
  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-300 mb-8 backdrop-blur-md shadow-inner">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    <span>{PROFILE.graduationStatus}</span>
  </div>

  <!-- Titolo principale -->
  <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white max-w-4xl leading-tight">
    {PROFILE.name}
  </h1>
  
  <p class="mt-4 text-xl sm:text-2xl font-medium bg-gradient-to-r from-violet-400 via-fuchsia-300 to-cyan-400 bg-clip-text text-transparent max-w-2xl font-mono">
    {PROFILE.title}
  </p>

  <p class="mt-6 text-slate-400 max-w-2xl text-base sm:text-lg leading-relaxed">
    {PROFILE.subheading}
  </p>

  <!-- Pulsanti di azione rapida -->
  <div class="mt-10 flex flex-wrap justify-center gap-4 text-sm font-mono">
    <a 
      href={PROFILE.github} 
      target="_blank" 
      rel="noopener noreferrer"
      class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 transition flex items-center gap-2 shadow-lg"
    >
      <span>GitHub Preview</span>
      <span class="text-xs text-slate-500">↗</span>
    </a>
    <a 
      href={`mailto:${PROFILE.email}`}
      class="px-5 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-medium transition shadow-lg shadow-violet-600/25 flex items-center gap-2"
    >
      <span>Contattami</span>
      <span class="text-xs">✉</span>
    </a>
  </div>

  <!-- Lingue parlate in pillole -->
  <div class="mt-10 flex flex-wrap justify-center gap-3 text-xs font-mono text-slate-400">
    {PROFILE.languages.map((lang) => (
      <span class="px-3 py-1 rounded-md bg-slate-900/50 border border-slate-800/80">
        <strong class="text-slate-300">{lang.name}:</strong> {lang.level}
      </span>
    ))}
  </div>
</header>