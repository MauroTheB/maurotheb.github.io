---
import { getPortfolio, type Locale } from '../../data/portfolio';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const { profile: PROFILE, ui: UI } = getPortfolio(lang);
---

<footer class="relative mt-24 border-t border-slate-900 bg-slate-950/80 backdrop-blur-xl">
  <!-- Sottile linea laser decorativa sulla sommità del footer -->
  <div class="absolute top-0 inset-x-0 h-[1px] bg-gradient-to-r from-transparent via-violet-500/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 py-16 flex flex-col md:flex-row items-center justify-between gap-10">
    
    <!-- Sezione Identità e CTA -->
    <div class="space-y-3 text-center md:text-left max-w-xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-mono text-cyan-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Open to Opportunities · Worldwide</span>
      </div>

      <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
        {UI.footerHeading}
      </h3>

      <p class="text-xs sm:text-sm text-slate-400 font-mono leading-relaxed">
        {UI.footerSubheading}
      </p>

      <p class="text-xs text-slate-500 font-mono pt-2">
        {PROFILE.name} • {PROFILE.title}
      </p>
    </div>

    <!-- Pulsanti di Contatto Rapido e Torna in Cima -->
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
      <!-- Contattami con box di copia nel Footer -->
    <div class="relative inline-block text-left w-full sm:w-auto">
      <button 
        id="footer-contact-btn"
        type="button"
        class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-mono text-xs font-bold transition flex items-center justify-center gap-2 shadow-lg shadow-violet-600/20 hover:scale-102 cursor-pointer"
      >
        <span>✉</span>
        <span>{UI.heroBtnContact}</span>
      </button>

      <div 
        id="footer-email-dropdown" 
        class="hidden absolute right-0 sm:left-1/2 sm:-translate-x-1/2 mt-3 w-72 p-3 rounded-2xl bg-slate-900 border border-slate-700 shadow-2xl backdrop-blur-2xl z-50 animate-detail-appear"
      >
        <div class="text-[11px] font-mono text-slate-400 mb-1.5 px-1">Email Diretta:</div>
        <div class="flex items-center justify-between gap-2 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2">
          <span class="text-xs font-mono text-cyan-300 select-all truncate">{PROFILE.email}</span>
          <button 
            id="footer-copy-clipboard-btn"
            type="button"
            class="px-2.5 py-1 rounded-lg bg-violet-600 hover:bg-violet-500 text-white text-[11px] font-mono font-bold transition flex items-center gap-1 shrink-0 cursor-pointer"
          >
            <span>Copy</span>
          </button>
        </div>
      </div>
    </div>

      <a 
        href="/Mauro_Brochier_CV.pdf"
        download="Mauro_Brochier_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-amber-300 border border-amber-500/40 text-xs font-mono font-bold transition flex items-center justify-center gap-2 shadow-lg hover:border-amber-400"
      >
        <span>📄</span>
        <span>{UI.heroBtnCv || (lang === 'it' ? "Scarica CV (PDF)" : "Download CV (PDF)")}</span>
        <span class="text-[10px]">↓</span>
      </a>

      <button 
        id="back-to-top-btn"
        aria-label="Back to top"
        class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800 text-slate-400 hover:text-cyan-400 border border-slate-800/80 text-xs font-mono transition flex items-center justify-center gap-1.5"
      >
        <span>{UI.backToTop}</span>
      </button>
    </div>

  </div>

  <!-- Sottile riga di chiusura con crediti e hosting CDN -->
  <div class="border-t border-slate-900/80 py-6 text-center text-slate-600 text-[11px] font-mono px-6">
    <p>{UI.footerText}</p>
  </div>
</footer>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }
  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>

<script>
  const fContactBtn = document.getElementById('footer-contact-btn');
  const fEmailDropdown = document.getElementById('footer-email-dropdown');
  const fCopyBtn = document.getElementById('footer-copy-clipboard-btn');

  fContactBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fEmailDropdown?.classList.toggle('hidden');
  });

  window.addEventListener('click', (e) => {
    if (!fContactBtn?.contains(e.target as Node) && !fEmailDropdown?.contains(e.target as Node)) {
      fEmailDropdown?.classList.add('hidden');
    }
  });

  fCopyBtn?.addEventListener('click', () => {
    const emailText = document.querySelector('#footer-email-dropdown span.select-all')?.textContent || '';
    navigator.clipboard.writeText(emailText).then(() => {
      const originalText = fCopyBtn.innerHTML;
      fCopyBtn.innerHTML = '<span class="text-emerald-300">✓ Copied!</span>';
      setTimeout(() => {
        fCopyBtn.innerHTML = originalText;
        fEmailDropdown?.classList.add('hidden');
      }, 1200);
    });
  });

  const btn = document.getElementById('back-to-top-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>